# Tùy chọn: để trống thì hệ thống chạy hoàn toàn offline.
# Endpoint phải tương thích OpenAI Chat Completions.
# Sao chép file này thành .env và điền thông tin; app tự đọc .env khi khởi động.
# AI dùng cho: gợi ý Socratic khi làm sai + "Cách giải nâng cao" khi làm đúng.
# Ví dụ OpenAI:  EDUCODER_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# Ví dụ Gemini:  EDUCODER_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
EDUCODER_LLM_ENDPOINT=
EDUCODER_LLM_API_KEY=
EDUCODER_LLM_MODEL=
